{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app24",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4078084d-02eb-46e9-b413-c95df47d98d1","database_name": "web-app24" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3c82df1dbe9c47109c52fd045452ddbe" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
